NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=workdesk.newhope.local

# Server-only secret used by:
# 1) scripts/bootstrap-users.mjs on the setup computer
# 2) the manager User Administration screen to create users and reset passwords
# Add this as a protected server environment variable in Vercel.
# Never prefix it with NEXT_PUBLIC and never expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# Legacy alternative if your project uses legacy keys:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Google Maps API key (client-side, for Places Autocomplete on the intake form address field)
# Enable "Maps JavaScript API" and "Places API" in your Google Cloud Console.
# Restrict to your Vercel domains under HTTP referrers.
# https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# RingCentral SMS Integration (renewal reminders)
# Create a REST API App with JWT auth in the RingCentral Developer Console.
# Permissions required: SMS, ReadAccounts
RC_CLIENT_ID=YOUR_RC_CLIENT_ID
RC_CLIENT_SECRET=YOUR_RC_CLIENT_SECRET
RC_JWT_TOKEN=YOUR_RC_JWT_TOKEN
RC_SMS_FROM_NUMBER=+1XXXXXXXXXX
RC_SERVER_URL=https://platform.ringcentral.com

# Email delivery for cancellation reminders (src/lib/email.ts, Resend REST API)
# Create an API key at https://resend.com/api-keys and verify the sending domain
# by DNS. CANCELLATION_EMAIL_FROM is the single agency from-address used on
# every outbound cancellation email; the display name is supplied per message.
# CANCELLATION_EMAIL_REPLY_TO is the default reply-to, overridden per case by
# the assigned employee's stored email address.
# Add all three as protected server environment variables in Vercel.
# Never prefix them with NEXT_PUBLIC and never expose them to browser code.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
CANCELLATION_EMAIL_FROM=notices@YOUR_VERIFIED_DOMAIN
CANCELLATION_EMAIL_REPLY_TO=service@YOUR_VERIFIED_DOMAIN

# ─────────────────────────────────────────────────────────────────────────────
# Carrier email submission (Specialty Quotes → Submissions tab)
#
# Sends carrier submissions from a Work Desk user's own Microsoft 365 mailbox, so
# carrier replies come back to them rather than to a shared relay address.
#
# Register a SINGLE-TENANT application in the Microsoft Entra admin center with
# delegated permissions Mail.Send, User.Read and offline_access. No mail-read
# scope is requested and none should ever be added — the permission list is what
# enforces "this application cannot read your inbox".
#
# MS_OAUTH_REDIRECT_URI must match a redirect URI registered on the application
# CHARACTER FOR CHARACTER, including scheme and the absence of a trailing slash.
# It differs per environment: localhost locally, the production host in Vercel.
# A domain that only resolves through an HTTP redirect cannot be used — Entra
# compares the string and never follows redirects.
#
# Add all four as protected server environment variables in Vercel. Never prefix
# any of them with NEXT_PUBLIC and never expose them to browser code.
MS_OAUTH_CLIENT_ID=YOUR_ENTRA_APPLICATION_CLIENT_ID
MS_OAUTH_CLIENT_SECRET=YOUR_ENTRA_CLIENT_SECRET_VALUE
MS_OAUTH_TENANT_ID=YOUR_ENTRA_DIRECTORY_TENANT_ID
MS_OAUTH_REDIRECT_URI=http://localhost:3000/api/email-connections/microsoft/callback

# AES-256-GCM key protecting the OAuth tokens stored in user_email_connections.
# Base64 of 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# The key is never written to the database, which is what makes a stolen backup
# inert. Losing it means every sender must reconnect their mailbox; submission
# history is unaffected because it holds no ciphertext. Keep a copy in a password
# manager, separate from the database.
EMAIL_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY
